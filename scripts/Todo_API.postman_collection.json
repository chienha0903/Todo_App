      "name": "01. Create Todo",
      "item": [
        {
          "name": "01a - Đầy đủ fields",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('No errors', () => pm.expect(res.errors).to.be.undefined);",
                  "pm.test('status = PENDING', () => pm.expect(res.data.createTodo.status).to.eql('PENDING'));",
                  "pm.test('priority = HIGH', () => pm.expect(res.data.createTodo.priority).to.eql('HIGH'));",
                  "pm.test('id not empty', () => pm.expect(res.data.createTodo.id).to.not.be.empty);",
                  "if (res.data && res.data.createTodo) pm.collectionVariables.set('todoId1', res.data.createTodo.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation CreateTodo($input: CreateTodoInput!) {\n  createTodo(input: $input) {\n    id userId title description status priority dueDate createdAt updatedAt\n  }\n}",
                "variables": "{\n  \"input\": {\n    \"userId\": 1,\n    \"title\": \"Hoàn thành báo cáo tháng 5\",\n    \"description\": \"Tổng hợp số liệu Q2 và viết nhận xét\",\n    \"priority\": \"HIGH\",\n    \"dueDate\": \"2026-05-31T17:00:00Z\"\n  }\n}"
              }
