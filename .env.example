# Application
APP_NAME=
APP_ENV=development

# BFF (todo-bff service)
BFF_PORT=8080
TODOS_GRPC_ADDR=localhost:50051
USERS_GRPC_ADDR=localhost:50052
REQUEST_TIMEOUT=5s

# JWT (must be at least 32 characters)
JWT_SECRET=

# Todos service
APP_TODOS_PORT=50051
DB_TODO_DSN=postgres://postgres:postgres@localhost:5432/todo_db?sslmode=disable

# Users service
APP_USERS_PORT=50052
DB_USERS_DSN=postgres://postgres:postgres@localhost:5433/user_db?sslmode=disable

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
