# --- Build stage ---
FROM golang:alpine AS builder

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN go build -o /bin/todos-consumer ./services/todos/cmd/consumer/main.go

# --- Runtime stage ---
FROM alpine:3.19

RUN apk --no-cache add ca-certificates tzdata

COPY --from=builder /bin/todos-consumer /bin/todos-consumer

ENTRYPOINT ["/bin/todos-consumer"]
