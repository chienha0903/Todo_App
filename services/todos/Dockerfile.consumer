# --- Build stage ---
FROM golang:alpine AS builder

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN go build -o /bin/todos-consumer ./services/todos/cmd/consumer/main.go

# --- Runtime stage ---
FROM alpine:3.19

RUN apk --no-cache add ca-certificates tzdata

WORKDIR /app

COPY --from=builder /bin/todos-consumer /bin/todos-consumer

COPY --from=builder /app/services/todos/internal/infra/datastore/migrations \
  ./services/todos/internal/infra/datastore/migrations

ENTRYPOINT ["/bin/todos-consumer"]